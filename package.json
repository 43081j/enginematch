{
  "name": "enginematch",
  "packageManager": "pnpm@12.16.1",
  "version": "0.0.1",
  "engines": {
    "node": ">=18.12.0"
  },
  "description": "A library to match user-defined engines and browserslist against targets.",
  "keywords": [
    "engines",
    "browserslist",
    "browsers",
    "compat-data"
  ],
  "files": [
    "lib",
    "!lib/**/*.test.js",
    "!lib/**/*.test.d.ts"
  ],
  "homepage": "https://github.com/43081j/enginematch#readme",
  "bugs": {
    "url": "https://github.com/43081j/enginematch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/43081j/enginematch.git"
  },
  "license": "MIT",
  "author": "James Garbutt (https://github.com/43081j)",
  "type": "module",
  "main": "./lib/main.js",
  "types": "./lib/main.d.ts",
  "exports": {
    ".": {
      "types": "./lib/main.d.ts",
      "default": "./lib/main.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "format": "prettier --write src",
    "lint": "pnpm run lint:format",
    "lint:format": "prettier --check src"
  },
  "dependencies": {
    "browserslist": "^4.29.5",
    "verkit": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "ignore"
    }
  }
}
